apiVersion: v1
kind: Service
metadata:
  name: {{ .Name }}-{{ .Component }}-metrics
  namespace: {{ .Namespace }}
  labels:
    {{- range $key, $value := .Labels }}
    {{ $key }}: {{ $value | quote }}
    {{- end }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: {{ .Name }}-{{ .Component }}
  ports:
    - name: metrics
      port: 8083
      protocol: TCP
      targetPort: 8083
