apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ .Name }}-{{ .Component }}
  namespace: {{ .Namespace }}
  labels:
    {{- range $key, $value := .Labels }}
    {{ $key }}: {{ $value | quote }}
    {{- end }}
  annotations:
    {{- if .Extra.IngressAnnotations }}
    {{- range $key, $value := .Extra.IngressAnnotations }}
    {{ $key }}: {{ $value | quote }}
    {{- end }}
    {{- else }}
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/backend-protocol: "HTTP"
    {{- end }}
spec:
  {{- if .Extra.IngressClassName }}
  ingressClassName: {{ .Extra.IngressClassName }}
  {{- end }}
  rules:
    - host: {{ .Extra.Host }}
      http:
        paths:
          - path: {{ .Extra.Path }}
            pathType: ImplementationSpecific
            backend:
              service:
                name: {{ .Name }}-{{ .Component }}
                port:
                  name: http
  tls:
    {{- if .Extra.TLS }}
    {{- range .Extra.TLS }}
    - hosts:
        {{- range .Hosts }}
        - {{ . | quote }}
        {{- end }}
      {{- if .SecretName }}
      secretName: {{ .SecretName }}
      {{- end }}
    {{- end }}
    {{- else }}
    - hosts:
        - {{ .Extra.Host }}
      secretName: argocd-secret
    {{- end }}
