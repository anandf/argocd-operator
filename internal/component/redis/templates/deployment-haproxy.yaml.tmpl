apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Name }}-redis-ha-haproxy
  namespace: {{ .Namespace }}
  labels:
    {{- range $key, $value := .Labels }}
    {{ $key }}: {{ $value | quote }}
    {{- end }}
spec:
  replicas: {{ .Extra.Replicas }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 0
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ .Name }}-redis-ha-haproxy
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ .Name }}-redis-ha-haproxy
        {{- range $key, $value := .Labels }}
        {{ $key }}: {{ $value | quote }}
        {{- end }}
      {{- if .Annotations }}
      annotations:
        {{- range $key, $value := .Annotations }}
        {{ $key }}: {{ $value | quote }}
        {{- end }}
      {{- end }}
    spec:
      serviceAccountName: {{ .ServiceAccount }}
      {{- if .Extra.IsOpenShift }}
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      {{- else }}
      securityContext:
        fsGroup: 1000
        runAsNonRoot: true
        runAsUser: 1000
        seccompProfile:
          type: RuntimeDefault
      {{- end }}
      initContainers:
        - name: config-init
          image: {{ .Extra.HAProxyImage }}
          imagePullPolicy: {{ .Extra.ImagePullPolicy | default "IfNotPresent" }}
          command:
            - sh
          args:
            - /readonly/haproxy_init.sh
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            runAsNonRoot: true
          volumeMounts:
            - name: config-volume
              mountPath: /readonly
              readOnly: true
            - name: data
              mountPath: /data
            - name: redis-auth
              mountPath: /app/config/redis-auth
              readOnly: true
            {{- if .Extra.UseTLS }}
            - name: redis-tls
              mountPath: /app/config/redis/tls
            {{- end }}
      containers:
        - name: haproxy
          image: {{ .Extra.HAProxyImage }}
          imagePullPolicy: {{ .Extra.ImagePullPolicy | default "IfNotPresent" }}
          {{- if .Extra.IsOpenShift }}
          command:
            - haproxy
            - -f
            - /usr/local/etc/haproxy/haproxy.cfg
          {{- end }}
          {{- if not .Extra.IsOpenShift }}
          args:
            - -f
            - /usr/local/etc/haproxy/haproxy.cfg
          {{- end }}
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8888
            initialDelaySeconds: 5
            periodSeconds: 3
          ports:
            - name: redis
              containerPort: 6379
              protocol: TCP
          {{- if .Extra.Resources }}
          resources:
            {{- if .Extra.Resources.Limits }}
            limits:
              {{- range $key, $value := .Extra.Resources.Limits }}
              {{ $key }}: "{{ $value }}"
              {{- end }}
            {{- end }}
            {{- if .Extra.Resources.Requests }}
            requests:
              {{- range $key, $value := .Extra.Resources.Requests }}
              {{ $key }}: "{{ $value }}"
              {{- end }}
            {{- end }}
          {{- end }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              {{- if .Extra.IsOpenShift }}
              add:
                - NET_BIND_SERVICE
              {{- end }}
              drop:
                - ALL
            runAsNonRoot: true
          volumeMounts:
            - name: data
              mountPath: /usr/local/etc/haproxy
            - name: shared-socket
              mountPath: /run/haproxy
            {{- if .Extra.UseTLS }}
            - name: redis-tls
              mountPath: /app/config/redis/tls
            {{- end }}
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                labelSelector:
                  matchLabels:
                    app.kubernetes.io/name: {{ .Name }}-redis-ha-haproxy
                topologyKey: failure-domain.beta.kubernetes.io/zone
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/name: {{ .Name }}-redis-ha-haproxy
              topologyKey: kubernetes.io/hostname
      {{- if .Extra.NodeSelector }}
      nodeSelector:
        {{- range $key, $value := .Extra.NodeSelector }}
        {{ $key }}: {{ $value | quote }}
        {{- end }}
      {{- end }}
      {{- if .Extra.Tolerations }}
      tolerations:
        {{- toYaml .Extra.Tolerations | nindent 8 }}
      {{- end }}
      volumes:
        - name: config-volume
          configMap:
            name: {{ .Name }}-redis-ha-configmap
        - name: shared-socket
          emptyDir: {}
        - name: data
          emptyDir: {}
        - name: redis-auth
          secret:
            secretName: {{ .Name }}-redis-initial-password
            defaultMode: 0400
        {{- if .Extra.UseTLS }}
        - name: redis-tls
          secret:
            secretName: {{ .Extra.TLSSecretName }}
            optional: true
        {{- end }}
