apiVersion: v1
kind: Service
metadata:
  name: {{ .Name }}-redis-ha-announce-{{ .Extra.AnnounceIndex }}
  namespace: {{ .Namespace }}
  labels:
    {{- range $key, $value := .Labels }}
    {{ $key }}: {{ $value | quote }}
    {{- end }}
  annotations:
    service.alpha.kubernetes.io/tolerate-unready-endpoints: "true"
    {{- range $key, $value := .Annotations }}
    {{ $key }}: {{ $value | quote }}
    {{- end }}
spec:
  type: ClusterIP
  publishNotReadyAddresses: true
  ports:
    - name: server
      port: 6379
      targetPort: redis
      protocol: TCP
    - name: sentinel
      port: 26379
      targetPort: sentinel
      protocol: TCP
  selector:
    app.kubernetes.io/name: {{ .Name }}-redis-ha
    statefulset.kubernetes.io/pod-name: {{ .Name }}-redis-ha-server-{{ .Extra.AnnounceIndex }}
